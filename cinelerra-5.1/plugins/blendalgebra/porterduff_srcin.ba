/***********************************************-*-C-*-**********/
/* Overlay mode: Porter-Duff Src In */

BLEND_ALGEBRA_INIT

COLORSPACE_RGB
PARALLEL_SAFE
REQUIRE_TRACKS(2)

BLEND_ALGEBRA_PROC

#define s 1
#define d 0

R_OUT = R(s) * A(d);
G_OUT = G(s) * A(d);
B_OUT = B(s) * A(d);
A_OUT = A(s) * A(d);
  
BLEND_ALGEBRA_END
