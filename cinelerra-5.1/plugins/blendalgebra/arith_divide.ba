/***********************************************-*-C-*-**********/
/* Overlay mode: Arithmetic Divide */

BLEND_ALGEBRA_INIT

COLORSPACE_RGB
PARALLEL_SAFE
REQUIRE_TRACKS(2)

BLEND_ALGEBRA_PROC

#define s 1
#define d 0

R_OUT = R(s) * (1-A(d)) + R(d) * (1-A(s));
G_OUT = G(s) * (1-A(d)) + G(d) * (1-A(s));
B_OUT = B(s) * (1-A(d)) + B(d) * (1-A(s));

if (R(d) != 0) R_OUT += R(s) / R(d);
if (G(d) != 0) G_OUT += G(s) / G(d);
if (B(d) != 0) B_OUT += B(s) / B(d);

A_OUT = A(s) + A(d) - A(s) * A(d);
  
BLEND_ALGEBRA_END
