/***********************************************-*-C-*-**********/
/* Overlay mode: Logical Or */

BLEND_ALGEBRA_INIT

COLORSPACE_RGB
PARALLEL_SAFE
REQUIRE_TRACKS(2)

BLEND_ALGEBRA_PROC

#define s 1
#define d 0

R_OUT = R(s) + R(d) - R(s) * R(d);
G_OUT = G(s) + G(d) - G(s) * G(d);
B_OUT = B(s) + B(d) - B(s) * B(d);
A_OUT = A(s) + A(d) - A(s) * A(d);
  
BLEND_ALGEBRA_END
