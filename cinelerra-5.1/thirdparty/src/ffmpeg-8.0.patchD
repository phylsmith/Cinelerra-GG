--- a/libavcodec/pcm-dvdenc.c	2025-05-12 17:20:39.267102833 -0600
+++ b/libavcodec/pcm-dvdenc.c	2025-05-12 17:22:13.361600238 -0600
@@ -38,6 +38,12 @@
     int quant, freq, frame_size;
 
     switch (avctx->sample_rate) {
+    case 32000:
+       freq = 3;
+       break;
+    case 44100:
+       freq = 2;
+       break;
     case 48000:
         freq = 0;
         break;
@@ -181,7 +187,7 @@
     .priv_data_size = sizeof(PCMDVDContext),
     .init           = pcm_dvd_encode_init,
     FF_CODEC_ENCODE_CB(pcm_dvd_encode_frame),
-    CODEC_SAMPLERATES(48000, 96000),
+    CODEC_SAMPLERATES(32000, 44100, 48000, 96000),
     CODEC_CH_LAYOUTS(AV_CHANNEL_LAYOUT_MONO,    AV_CHANNEL_LAYOUT_STEREO,
                      AV_CHANNEL_LAYOUT_5POINT1, AV_CHANNEL_LAYOUT_7POINT1),
     CODEC_SAMPLEFMTS(AV_SAMPLE_FMT_S16, AV_SAMPLE_FMT_S32),
