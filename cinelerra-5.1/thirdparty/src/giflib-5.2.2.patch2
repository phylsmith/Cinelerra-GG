-	int hash2 = entry2->RGB[SortRGBAxis] * 256 * 256 +
-	            entry2->RGB[(SortRGBAxis + 1) % 3] * 256 +
-	            entry2->RGB[(SortRGBAxis + 2) % 3];
-
-	return hash1 - hash2;
-}
